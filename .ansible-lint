profile: production
# The examples use the published Galaxy name (hyphenated). ansible-lint only
# links this checkout as devopsgroupeu.hashicorp_vault, so mock the Galaxy name.
mock_roles:
  - devopsgroupeu.hashicorp-vault
exclude_paths:
  - .github/
  - .ansible-lint
  - venv/
  - .git/
warn_list:
  - no-handler
  - var-spacing
  - var-naming
  - yaml[comments-indentation]
skip_list:
  - experimental
  - yaml[line-length]
enable_list:
  - no-log-password
  - loop-var-prefix
